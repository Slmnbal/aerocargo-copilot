# LLM_SAGLAYICI: "ollama" (varsayılan, yerel/ücretsiz, key gerektirmez) veya "groq"
# (bulut, ücretsiz katman). Boş bırakılırsa ollama kullanılır.
LLM_SAGLAYICI=ollama

# Sadece LLM_SAGLAYICI=groq iken gerekli. Ücretsiz key: https://console.groq.com/keys
GROQ_API_KEY=

# Bu dosya hem yerel çalıştırmada (python-dotenv) hem de "docker compose up" ile
# (compose'un kendi .env okuma mekanizması, bkz. docker-compose.yml) kullanılıyor.
